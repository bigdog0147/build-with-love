# Primary Lovable Cloud / Supabase project (required)
# These values are available in your Lovable project settings.
SUPABASE_PROJECT_ID="your_primary_project_ref"
SUPABASE_URL="https://your-primary-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_primary_anon_key"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_primary_service_role_key"

# Browser-visible copies of the primary Supabase config (required)
# In local dev these are usually identical to the SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY above.
VITE_SUPABASE_PROJECT_ID="your_primary_project_ref"
VITE_SUPABASE_URL="https://your-primary-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_primary_anon_key"

# Optional: secondary / external Supabase project
# Required for Admin → External data and Admin → KYC documents.
EXT_SUPABASE_URL="https://your_external_project_ref.supabase.co"
EXT_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_external_anon_key"
EXT_SUPABASE_SECRET_KEY="sb_secret_your_external_service_role_key"
EXT_SUPABASE_JWKS_URL="https://your_external_project_ref.supabase.co/auth/v1/.well-known/jwks.json"

# Optional: OTP resend cooldown in seconds (default: 60)
VITE_RESET_LIMIT_COOLDOWN_SECONDS="60"

# Shared secret required by scheduled-job endpoints under /api/public/*
# Sent by the scheduler as the "x-cron-secret" header. Server-only, never public.
CRON_SECRET=
